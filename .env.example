# PostgreSQL
POSTGRES_USER=automl
POSTGRES_PASSWORD=automl
POSTGRES_DB=automl

# Redis
REDIS_URL=redis://redis:6379/0

# MinIO (отдельный compose: docker-compose.minio.yml)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Секрет для вызова POST /api/internal/storage/sync из Celery worker (тот же токен у backend и ml)
INTERNAL_STORAGE_TOKEN=change-me-long-random-string

# Backend / ML (auto-constructed, override if needed)
DATABASE_URL=postgresql+psycopg2://automl:automl@postgres:5432/automl
CELERY_BROKER_URL=redis://redis:6379/0
